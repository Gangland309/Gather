{
  "name": "gather-platform",
  "private": true,
  "version": "0.9.26",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "server": "node server/server.mjs",
    "mobile": "npm --prefix mobile start",
    "web": "npm --prefix mobile run web",
    "build:web": "npm --prefix mobile run build:web",
    "check": "npm --prefix mobile run check",
    "test": "node --test tests/*.test.mjs",
    "build:all": "npm --prefix mobile run build:all",
    "lint": "npm --prefix mobile run lint"
  },
  "dependencies": {
    "discord.js": "^14.27.0",
    "livekit-server-sdk": "^2.19.1"
  }
}
