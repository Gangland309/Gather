# Development: use your computer's LAN IP for a physical phone, not localhost.
# The variable is public and MUST NOT contain secrets.
EXPO_PUBLIC_API_URL=http://localhost:8787

EXPO_PUBLIC_SITE_URL=https://gatherourworld.com

# Render production web: leave EXPO_PUBLIC_API_URL unset for same-origin API,
# or set it to https://gatherourworld.com (site origin; do not append /api).
# Rebuild/redeploy after changing EXPO_PUBLIC variables.
