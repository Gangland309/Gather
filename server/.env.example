# Local development examples; copy to .env and keep secrets out of Git.
HOST=127.0.0.1
PORT=8787
# Hosted environment requires persistent storage.
# DATA_DIR=/var/data
# NODE_ENV=production
# PUBLIC_ORIGIN=https://gatherourworld.com
# RESEND_API_KEY=Set this directly in Render
# EMAIL_FROM=Gather <no-reply@mail.gatherourworld.com>
# ADMIN_EMAIL=Your trusted account email
# SUPPORT_EMAIL=Your actual receiving inbox (optional)
# EMAIL_VERIFICATION_REQUIRED=true
CORS_ORIGINS=http://localhost:8081,https://gatherourworld.com,https://www.gatherourworld.com,https://gather-69ig.onrender.com

# Optional Mux video (server-only secrets; enter directly in Render)
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_SIGNING_KEY_ID=
# MUX_SIGNING_PRIVATE_KEY=
# Optional LiveKit Cloud (cloud URL with no trailing slash)
# LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Invite-only pilot: existing accounts can still sign in; admins issue single-use codes.
# INVITE_ONLY=true

# Discord account linking and optional shared-server status bridge (server-only)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
# DISCORD_SERVER_INVITE=https://discord.gg/your-code
# Register PUBLIC_ORIGIN + /api/discord/callback in the Discord Developer Portal.
